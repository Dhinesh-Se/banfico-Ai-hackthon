    "UltimateCreditor": {
        "SchemeName": "UK.OBIE.SortCodeAccountNumber",
        "PostalAddress": {
            "AddressLine": "{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}"
        }
    },
    "UltimateDebtor": {
        "SchemeName": "UK.OBIE.SortCodeAccountNumber",
        "PostalAddress": {
            "AddressLine": "{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}"
        }
    },
    "CardInstrument": {
        "CardSchemeName": "MasterCard",
        "AuthorisationType": "PIN"
    }
}

Scripts:
Pre-request:
function randomDigits(length) {
    let result = '';
    for (let i = 0; i < length; i++) {
        result += Math.floor(Math.random() * 10);
    }
    return result;
}

function randomAmount(min, max) {
    return (Math.random() * (max - min) + min).toFixed(2);
}

pm.variables.set("transactionRef", "Ref " + randomDigits(12));
pm.variables.set("transactionAmount", randomAmount(1, 500));
pm.variables.set("balanceAmount", randomAmount(50, 5000));
pm.variables.set("creditorAgentId", randomDigits(14));
pm.variables.set("debtorAgentId", randomDigits(13));

const descriptions = ["Paid the gas bill", "Grocery shopping", "Monthly rent transfer", "Restaurant payment", "Online subscription", "Utility bill payment"];
pm.variables.set("transactionInfo", descriptions[Math.floor(Math.random() * descriptions.length)]);

Post-response:
// Auto-capture the first AccountId from the response and store it as a collection variable
pm.test("Status code is 200", function () {
    pm.response.to.have.status(200);
});



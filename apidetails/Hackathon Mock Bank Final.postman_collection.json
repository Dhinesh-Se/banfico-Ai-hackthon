    {
      "name": "POST Accounts",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function randomDigits(length) {",
              "    let result = '';",
              "    for (let i = 0; i < length; i++) {",
              "        result += Math.floor(Math.random() * 10);",
              "    }",
              "    return result;",
              "}",
              "",
              "pm.collectionVariables.set(\"accountIdentification\", randomDigits(14));   // 14-digit sort code + account number",
              "pm.collectionVariables.set(\"secondaryIdentification\", randomDigits(5));  // 5-digit secondary id",
              "pm.collectionVariables.set(\"accountBalance\", (Math.random() * 5000).toFixed(2)); // random balance 0-5000",
              "const nicknames = [\"Savings\", \"Rainy Day\", \"Bills\", \"Holiday Fund\", \"Everyday\", \"Emergency\"];",
              "pm.variables.set(\"accountNickname\", nicknames[Math.floor(Math.random() * nicknames.length)]);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Auto-capture the first AccountId from the response and store it as a collection variable",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {

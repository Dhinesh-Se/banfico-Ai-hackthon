  "item": [
    {
      "name": "TOKEN API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Auto-capture access_token from the response and store it as a collection variable",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {",
              "    jsonData = null;",
              "}",
              "",
              "if (jsonData && jsonData.access_token) {",
              "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
              "    console.log(\"access_token saved to collection variables\");",
              "} else {",
              "    console.warn(\"access_token not found in TOKEN API response\");",
              "}",
              "",
              "if (jsonData && jsonData.refresh_token) {",
              "    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh_token);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {

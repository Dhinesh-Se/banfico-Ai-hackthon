          },
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"TransactionReference\": \"{{transactionRef}}\",\n    \"Amount\": {\n        \"Amount\": \"{{transactionAmount}}\",\n        \"Currency\": \"GBP\"\n    },\n    \"CreditDebitIndicator\": \"Credit\",\n    \"Status\": \"PDNG\",\n    \"BookingDateTime\": \"{{$isoTimestamp}}\",\n    \"ValueDateTime\": \"{{$isoTimestamp}}\",\n    \"TransactionInformation\": \"{{transactionInfo}}\",\n    \"BankTransactionCode\": {\n        \"Code\": \"IssuedCreditTransfer\",\n        \"SubCode\": \"AutomaticTransfer\"\n    },\n    \"ProprietaryBankTransactionCode\": {\n        \"Code\": \"Transfer\",\n        \"Issuer\": \"CoreBank\"\n    },\n    \"ExtendedProprietaryBankTransactionCodes\": [\n        {\n            \"Code\": \"{{$randomWord}}\"\n        }\n    ],\n    \"Balance\": {\n        \"Amount\": {\n            \"Amount\": \"{{balanceAmount}}\",\n            \"Currency\": \"GBP\"\n        },\n        \"CreditDebitIndicator\": \"Credit\",\n        \"Type\": \"ITBD\"\n    },\n    \"PaymentPurposeCode\": \"CASH\",\n    \"MerchantDetails\": {\n        \"MerchantName\": \"{{$randomCompanyName}}\",\n        \"MerchantCategoryCode\": \"1711\"\n    },\n    \"CreditorAgent\": {\n        \"SchemeName\": \"UK.OBIE.BICFI\",\n        \"Identification\": \"{{creditorAgentId}}\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"CreditorAccount\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\"\n    },\n    \"DebtorAgent\": {\n        \"SchemeName\": \"UK.OBIE.BICFI\",\n        \"Identification\": \"{{debtorAgentId}}\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"DebtorAccount\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\"\n    },\n    \"UltimateCreditor\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"UltimateDebtor\": {\n        \"SchemeName\": \"UK.OBIE.SortCodeAccountNumber\",\n        \"PostalAddress\": {\n            \"AddressLine\": \"{{$randomStreetAddress}}, {{$randomCity}}, England, {{$randomZipCode}}\"\n        }\n    },\n    \"CardInstrument\": {\n        \"CardSchemeName\": \"MasterCard\",\n        \"AuthorisationType\": \"PIN\"\n    }\n}",
          "options": {

    {
      "name": "GET Accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Auto-capture the first AccountId from the response and store it as a collection variable",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let jsonData;",
              "try {",
              "    jsonData = pm.response.json();",
              "} catch (e) {",
              "    jsonData = null;",
              "}",
              "",
              "if (jsonData && jsonData.Data && Array.isArray(jsonData.Data.Account) && jsonData.Data.Account.length > 0) {",
              "    const accountId = jsonData.Data.Account[0].AccountId;",
              "    pm.collectionVariables.set(\"accountId\", accountId);",
              "    console.log(\"accountId saved to collection variables: \" + accountId);",
              "} else {",
              "    console.warn(\"No accounts found in response to extract accountId from\");",
              "}"
            ]
          }
        }
      ],
